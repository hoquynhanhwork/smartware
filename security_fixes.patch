diff --git a/db/migrations/2026-10-05_security_hardening.sql b/db/migrations/2026-10-05_security_hardening.sql
new file mode 100644
index 0000000..4bc80af
--- /dev/null
+++ b/db/migrations/2026-10-05_security_hardening.sql
@@ -0,0 +1,112 @@
+-- 2026-10-05_security_hardening.sql
+-- Chạy:  psql -U postgres -d smartware -v ON_ERROR_STOP=1 -v ro_password='MAT_KHAU_RO' -f <file>
+-- Làm 3 việc, trong một transaction:
+--   1. Tạo role chỉ-đọc smartware_ai_ro + schema ai_ro (view đã lọc theo nhà cung cấp) cho text-to-SQL
+--   2. Sửa hash mật khẩu bị cắt của 9 tài khoản seed (mật khẩu tạm, đổi ngay sau khi đăng nhập)
+BEGIN;
+
+-- ── 1. Role chỉ-đọc cho text-to-SQL ────────────────────────────────────
+DO $$
+BEGIN
+    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'smartware_ai_ro') THEN
+        CREATE ROLE smartware_ai_ro LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT CONNECTION LIMIT 10;
+    END IF;
+END
+$$;
+
+ALTER ROLE smartware_ai_ro PASSWORD :'ro_password';
+ALTER ROLE smartware_ai_ro SET search_path = ai_ro;
+ALTER ROLE smartware_ai_ro SET statement_timeout = '8s';
+ALTER ROLE smartware_ai_ro SET idle_in_transaction_session_timeout = '15s';
+ALTER ROLE smartware_ai_ro SET default_transaction_read_only = on;
+
+CREATE SCHEMA IF NOT EXISTS ai_ro;
+REVOKE ALL ON SCHEMA ai_ro FROM PUBLIC;
+GRANT USAGE ON SCHEMA ai_ro TO smartware_ai_ro;
+REVOKE ALL ON ALL TABLES IN SCHEMA public FROM smartware_ai_ro;
+
+-- Nhà cung cấp hiện tại do service đặt bằng set_config('app.supplier_id', ..., true)
+-- cho mỗi giao dịch. Không có giá trị thì mọi view đều trả 0 dòng.
+CREATE OR REPLACE FUNCTION ai_ro.current_supplier() RETURNS integer
+LANGUAGE sql STABLE AS $$
+    SELECT NULLIF(current_setting('app.supplier_id', true), '')::integer
+$$;
+
+DROP VIEW IF EXISTS ai_ro.products, ai_ro.suppliers, ai_ro.categories,
+    ai_ro.stock_inbounds, ai_ro.stock_inbound_items,
+    ai_ro.stock_outbounds, ai_ro.stock_outbound_items,
+    ai_ro.inventory_batches, ai_ro.inventory_history,
+    ai_ro.forecasts, ai_ro.trends, ai_ro.alerts, ai_ro.warehouse_assessment;
+
+CREATE VIEW ai_ro.products WITH (security_barrier = true) AS
+    SELECT * FROM public.products
+    WHERE supplier_id = ai_ro.current_supplier() AND deleted_at IS NULL;
+
+CREATE VIEW ai_ro.suppliers WITH (security_barrier = true) AS
+    SELECT * FROM public.suppliers
+    WHERE id = ai_ro.current_supplier() AND deleted_at IS NULL;
+
+CREATE VIEW ai_ro.categories WITH (security_barrier = true) AS
+    SELECT * FROM public.categories WHERE deleted_at IS NULL;
+
+CREATE VIEW ai_ro.stock_inbounds WITH (security_barrier = true) AS
+    SELECT * FROM public.stock_inbounds
+    WHERE supplier_id = ai_ro.current_supplier() AND deleted_at IS NULL;
+
+CREATE VIEW ai_ro.stock_inbound_items WITH (security_barrier = true) AS
+    SELECT i.* FROM public.stock_inbound_items i
+    JOIN public.stock_inbounds s ON s.id = i.inbound_id
+    WHERE s.supplier_id = ai_ro.current_supplier() AND s.deleted_at IS NULL;
+
+CREATE VIEW ai_ro.stock_outbounds WITH (security_barrier = true) AS
+    SELECT * FROM public.stock_outbounds
+    WHERE supplier_id = ai_ro.current_supplier() AND deleted_at IS NULL;
+
+CREATE VIEW ai_ro.stock_outbound_items WITH (security_barrier = true) AS
+    SELECT i.* FROM public.stock_outbound_items i
+    JOIN public.stock_outbounds s ON s.id = i.outbound_id
+    WHERE s.supplier_id = ai_ro.current_supplier() AND s.deleted_at IS NULL;
+
+CREATE VIEW ai_ro.inventory_batches WITH (security_barrier = true) AS
+    SELECT * FROM public.inventory_batches
+    WHERE supplier_id = ai_ro.current_supplier();
+
+CREATE VIEW ai_ro.inventory_history WITH (security_barrier = true) AS
+    SELECT h.* FROM public.inventory_history h
+    JOIN public.products p ON p.id = h.product_id
+    WHERE p.supplier_id = ai_ro.current_supplier();
+
+CREATE VIEW ai_ro.forecasts WITH (security_barrier = true) AS
+    SELECT * FROM public.forecasts WHERE supplier_id = ai_ro.current_supplier();
+
+CREATE VIEW ai_ro.trends WITH (security_barrier = true) AS
+    SELECT * FROM public.trends WHERE supplier_id = ai_ro.current_supplier();
+
+CREATE VIEW ai_ro.alerts WITH (security_barrier = true) AS
+    SELECT * FROM public.alerts WHERE supplier_id = ai_ro.current_supplier();
+
+CREATE VIEW ai_ro.warehouse_assessment WITH (security_barrier = true) AS
+    SELECT * FROM public.warehouse_assessment WHERE supplier_id = ai_ro.current_supplier();
+
+GRANT SELECT ON ALL TABLES IN SCHEMA ai_ro TO smartware_ai_ro;
+
+-- ── 2. Sửa 9 tài khoản seed có hash bị cắt (không có tiền tố $2y$) ─────
+-- Chỉ đụng tới dòng có hash không phải bcrypt, nên chạy lại cũng an toàn
+-- và không bao giờ ghi đè mật khẩu hợp lệ (vd. admin).
+UPDATE public.users u
+SET password = v.new_hash, updated = now()
+FROM (VALUES
+        ('manager1', '$2y$10$S3Y7s5REEFP4oaVV6kVqPOWR9lyIYdIsRqmaf6I0U9rZD9VC0ZwEO'),
+        ('staff1', '$2y$10$JZr4ZTVgYFIdoFhWOyldRu./G/1lHxBpiZOVcV1yNgyeWwckqSrw2'),
+        ('staff2', '$2y$10$cJ30JD3xx2dJUBTpxq7d..6PwEb3aBLSktbxcsarsZR2B8qWJIPvG'),
+        ('staff3', '$2y$10$KH2lkQZEOrUGkMBRZ2kpU.dR7LgOBSpgHUfBN3MjprU2ulD3eIgkm'),
+        ('staff4', '$2y$10$Tq1t6zrYSaEVrHDvw9Y3f.DJcZcUZ2WlKJB6pUeFI0kXk9ZlJhLnG'),
+        ('staff5', '$2y$10$svE2ejyhK99beSVSiU/F6.pjt6cnIVWAfF11.saD8T/V6JnMjfJma'),
+        ('staff6', '$2y$10$7rrvEK9HdrYmytKEFEqlruRi9l2t6WVamkqkCiiMYz2i1A7goudNW'),
+        ('staff7', '$2y$10$fX5gxlnV88WwDSA0LInD6eITRCQ5y2CkGHYHYYQAt2p2DZMd0qat6'),
+        ('staff8', '$2y$10$ROavnYiLUu4xrPdqBZHo8.3B3KAVzYPSQYCM4aUKXFt0K2RZHAjsy')
+) AS v(username, new_hash)
+WHERE u.username = v.username
+  AND u.password !~ '^[$]2[aby][$][0-9]{2}[$].{53}$';
+
+COMMIT;
